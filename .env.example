# Brand
PRODUCT_NAME="your-product-name"
APP_URL="https://app.yourdomain.com"
VIEWER_URL="https://view.yourdomain.com"

# Database
DATABASE_URL="postgres://your_db_user:your_db_password@localhost:5433/your_db_name"

# Auth
BETTER_AUTH_SECRET="your-32-char-random-base64-secret"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Storage (MinIO locally, R2 in production)
S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
S3_REGION="your-s3-region"
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
S3_BUCKET="your-storage-bucket-name"

# File conversion
GOTENBERG_URL="https://gotenberg.yourdomain.com"
