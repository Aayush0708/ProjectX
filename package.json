{
  "name": "projectx",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @projectx/shared db:generate",
    "db:migrate": "pnpm --filter @projectx/shared db:migrate",
    "db:studio": "pnpm --filter @projectx/shared db:studio"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2"
  }
}